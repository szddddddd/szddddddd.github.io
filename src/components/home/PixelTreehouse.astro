---
import type { Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props as Props;
const label = lang === 'zh' ? '可交互的泰拉瑞亚海岛：田园农庄、岛内树林、点击出航捕鱼与收集鱼获，海盗白天炮击鲨鱼' : 'An interactive Terraria island with gardens, inland trees, clickable fishing trips and catch collection, and daytime pirate shark battles';
---
<voxel-habitat data-lang={lang} role="group" aria-label={label}>
  <img src="/assets/pixel-habitat/coastal-3d.png" width="960" height="720" alt="" aria-hidden="true" />
  <canvas aria-hidden="true"></canvas>
  <div class="scene-controls" aria-label={lang === 'zh' ? '场景视角' : 'Scene view'}>
    <button type="button" data-zoom="in" aria-label={lang === 'zh' ? '放大场景' : 'Zoom in'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg></button>
    <button type="button" data-zoom="out" aria-label={lang === 'zh' ? '缩小场景' : 'Zoom out'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg></button>
    <button type="button" data-zoom="reset" aria-label={lang === 'zh' ? '复位场景' : 'Reset scene'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10a8 8 0 1 1 2 8M4 4v6h6" /></svg></button>
  </div>
  <div class="fishery-actions">
    <button type="button" data-fishery="sail" aria-label={lang === 'zh' ? '出航捕鱼' : 'Set sail'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 15h18l-3 5H6zM11 3v10H4zM14 6l5 7h-5M3 23l3-1 3 1 3-1 3 1 3-1 3 1" /></svg></button>
    <button type="button" data-fishery="collect" aria-label={lang === 'zh' ? '收集鱼获' : 'Collect catch'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 14h18l-2 7H5zM5 10c3-5 7-5 10-2l5-3v7l-5-2c-4 3-7 2-10 0z" /></svg></button>
  </div>
</voxel-habitat>
<script>
  import { VoxelHabitat } from './voxelHabitat';
  if (!customElements.get('voxel-habitat')) customElements.define('voxel-habitat', VoxelHabitat);
</script>
<style>
  voxel-habitat {
    display: block;
    position: relative;
    width: min(100%, 40rem);
    aspect-ratio: 4 / 3;
    margin-top: .5rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: #489ead;
  }
  img, canvas { display: block; width: 100%; height: 100%; }
  canvas { position: absolute; inset: 0; opacity: 0; touch-action: pan-y; cursor: grab; }
  canvas:active { cursor: grabbing; }
  .scene-controls { position: absolute; top: .65rem; right: .65rem; display: flex; gap: .3rem; z-index: 2; }
  button { border: 1px solid #ffffff55; border-radius: .4rem; min-width: 2.5rem; height: 2.5rem; padding: 0 .6rem; background: #142d3cdd; color: #fff; cursor: pointer; font: inherit; }
  button:focus-visible { outline: 2px solid #84e3eb; outline-offset: 2px; }
  svg { width:1.1rem; height:1.1rem; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
  button { display:grid; place-items:center; background:#142d3c99; }
  .fishery-actions { position:absolute; bottom:.65rem; right:.65rem; display:flex; gap:.3rem; z-index:2; }
  button:disabled { opacity:.35; cursor:default; }
  voxel-habitat[data-ready] canvas { opacity: 1; }
  voxel-habitat[data-ready] img { visibility: hidden; }
</style>
