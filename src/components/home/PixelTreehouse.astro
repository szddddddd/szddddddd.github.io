---
import type { Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props as Props;
const label = lang === 'zh' ? '海浪轻涌的三维海岸木屋，烟囱升起炊烟，小人在码头钓鱼' : 'A coastal home with rolling waves, chimney smoke and a person fishing from the pier';
---
<voxel-habitat role="img" aria-label={label}>
  <img src="/assets/pixel-habitat/coastal-3d.png" width="960" height="720" alt="" aria-hidden="true" />
  <canvas aria-hidden="true"></canvas>
</voxel-habitat>
<script>
  import { VoxelHabitat } from './voxelHabitat';
  if (!customElements.get('voxel-habitat')) customElements.define('voxel-habitat', VoxelHabitat);
</script>
<style>
  voxel-habitat {
    display: block;
    position: relative;
    width: min(100%, 40rem);
    aspect-ratio: 4 / 3;
    margin-top: .5rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: #489ead;
  }
  img, canvas { display: block; width: 100%; height: 100%; }
  canvas { position: absolute; inset: 0; opacity: 0; touch-action: pan-y; cursor: grab; }
  canvas:active { cursor: grabbing; }
  voxel-habitat[data-ready] canvas { opacity: 1; }
  voxel-habitat[data-ready] img { visibility: hidden; }
</style>
