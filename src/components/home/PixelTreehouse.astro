---
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const copy = lang === 'zh'
  ? {
      label: '黄昏天空下，建在树木与水岸之间的多层像素木屋剖面',
      credit: '像素素材：Buch，CC0',
    }
  : {
      label: 'A cutaway pixel tree house between a forest and the water at dusk',
      credit: 'Pixel assets by Buch, CC0',
    };
---

<figure class="pixel-habitat">
  <div class="pixel-habitat__frame">
    <div class="pixel-scene" role="img" aria-label={copy.label}>
      <div class="pixel-scene__sky">
        <i class="cloud cloud--one"></i>
        <i class="cloud cloud--two"></i>
        <i class="cloud cloud--three"></i>
        <i class="moon"></i>
      </div>

      <i class="forest-tree forest-tree--left"></i>
      <i class="forest-tree forest-tree--high"></i>
      <i class="forest-tree forest-tree--right"></i>

      <div class="island island--left"></div>
      <div class="island island--right"></div>
      <div class="water"><i></i><i></i><i></i></div>

      <div class="treehouse">
        <div class="roof roof--upper"></div>
        <div class="roof roof--right"></div>

        <div class="room room--upper">
          <i class="window window--tall"></i>
          <i class="table table--wide"></i>
          <i class="shelf"></i>
          <i class="asset asset--sign"></i>
          <i class="asset asset--chest"></i>
          <i class="lamp lamp--one"></i>
        </div>

        <div class="room room--middle-left">
          <i class="window"></i>
          <i class="table"></i>
          <i class="asset asset--bench"></i>
          <i class="lamp lamp--two"></i>
        </div>

        <div class="room room--middle-center">
          <i class="asset asset--ladder asset--ladder-tall"></i>
          <i class="asset asset--character"></i>
          <i class="asset asset--fire"></i>
          <i class="lamp lamp--three"></i>
        </div>

        <div class="room room--middle-right">
          <i class="window"></i>
          <i class="bed"></i>
          <i class="asset asset--chest"></i>
          <i class="asset asset--sign"></i>
        </div>

        <div class="room room--workshop">
          <i class="asset asset--ladder asset--ladder-tall"></i>
          <i class="workbench"></i>
          <i class="asset asset--bench"></i>
          <i class="asset asset--fire"></i>
          <i class="lamp lamp--four"></i>
        </div>

        <div class="beam beam--upper"></div>
        <div class="beam beam--middle"></div>
        <div class="beam beam--lower"></div>
        <div class="support support--one"></div>
        <div class="support support--two"></div>
        <div class="support support--three"></div>
        <div class="bridge"></div>
      </div>

      <i class="asset asset--character character--dock"></i>
      <i class="asset asset--chest chest--dock"></i>
      <i class="firefly firefly--one"></i>
      <i class="firefly firefly--two"></i>
      <i class="firefly firefly--three"></i>
    </div>
  </div>

  <figcaption>
    <a class="pixel-habitat__credit" href="https://opengameart.org/content/a-platformer-in-the-forest" target="_blank" rel="noreferrer">
      {copy.credit} ↗
    </a>
  </figcaption>
</figure>

<style>
  .pixel-habitat {
    width: min(100%, 34rem);
    margin: .15rem 0 0;
  }

  .pixel-habitat__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid color-mix(in srgb, var(--accent-home) 38%, var(--color-line));
    background: #303a83;
    box-shadow: 0 28px 80px rgba(0, 0, 0, .24);
  }

  .pixel-habitat__frame::after {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    background: linear-gradient(115deg, rgba(255, 255, 255, .07), transparent 25%, transparent 74%, rgba(8, 11, 30, .2));
    content: '';
  }

  .pixel-scene {
    position: absolute;
    top: 0;
    left: 50%;
    width: max(100%, 620px);
    aspect-ratio: 96 / 52;
    overflow: hidden;
    image-rendering: pixelated;
    transform: translateX(-50%);
  }

  .pixel-scene__sky {
    position: absolute;
    inset: 0 0 24%;
    background: linear-gradient(#3548a8 0%, #7260a8 54%, #d08da8 100%);
  }

  .cloud {
    position: absolute;
    width: 11%;
    height: 3.4%;
    background: #d596b7;
    box-shadow: 12px -8px 0 #d596b7, 30px 0 0 #d596b7, 48px 6px 0 #d596b7;
    opacity: .62;
    animation: cloud-drift 14s steps(10, end) infinite alternate;
  }

  .cloud--one { top: 12%; left: 7%; }
  .cloud--two { top: 23%; left: 52%; animation-direction: alternate-reverse; }
  .cloud--three { top: 8%; right: 12%; opacity: .34; animation-duration: 19s; }

  .moon {
    position: absolute;
    top: 13%;
    right: 9%;
    width: 4.2%;
    aspect-ratio: 1;
    background: #ffd0be;
    box-shadow: 0 0 0 6px rgba(255, 179, 190, .16), 0 0 28px #f5a9bd;
  }

  .forest-tree,
  .asset {
    position: absolute;
    z-index: 4;
    display: block;
    background-image: url('/assets/pixel-habitat/forest-sheet.png');
    background-repeat: no-repeat;
    image-rendering: pixelated;
  }

  .forest-tree {
    width: 224px;
    height: 256px;
    background-size: 544px 256px;
    background-position: 0 0;
    transform-origin: bottom center;
  }

  .forest-tree--left { bottom: 24%; left: -2%; transform: scale(1.18); }
  .forest-tree--high { top: 1%; left: 42%; transform: scale(.88); }
  .forest-tree--right { right: 0; bottom: 27%; transform: scaleX(-1) scale(.92); }

  .island {
    position: absolute;
    z-index: 2;
    bottom: 0;
    background:
      linear-gradient(#577b36 0 10px, transparent 10px),
      repeating-linear-gradient(90deg, #35243f 0 20px, #412a45 20px 40px);
    border-top: 8px solid #7ca735;
  }

  .island--left { left: 0; width: 45%; height: 28%; }
  .island--right { right: 0; width: 27%; height: 19%; }

  .water {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 58%;
    height: 23%;
    overflow: hidden;
    background: linear-gradient(#268ec2, #103c73);
    border-top: 6px solid #70cee1;
  }

  .water i {
    position: absolute;
    bottom: -10%;
    width: 8px;
    height: 72%;
    background: #15578a;
    box-shadow: 13px -15px 0 #15578a, 26px 8px 0 #15578a;
  }

  .water i:nth-child(1) { left: 18%; }
  .water i:nth-child(2) { left: 53%; transform: scaleY(.7); }
  .water i:nth-child(3) { right: 12%; transform: scaleY(1.2); }

  .treehouse { position: absolute; inset: 0; z-index: 6; }

  .room {
    position: absolute;
    overflow: hidden;
    border: 6px solid #3b2227;
    background:
      linear-gradient(rgba(255, 224, 155, .18), rgba(255, 224, 155, .18)),
      repeating-linear-gradient(90deg, #9a714d 0 22px, #825d43 22px 24px);
    box-shadow: inset 0 0 0 3px #59392f;
  }

  .room--upper { top: 20%; left: 23%; width: 39%; height: 27%; }
  .room--middle-left { top: 47%; left: 12%; width: 28%; height: 23%; }
  .room--middle-center { top: 47%; left: 40%; width: 21%; height: 23%; }
  .room--middle-right { top: 39%; left: 61%; width: 22%; height: 31%; }
  .room--workshop { top: 70%; left: 40%; width: 39%; height: 18%; background-color: #795646; }

  .roof {
    position: absolute;
    z-index: 9;
    height: 7%;
    border: 6px solid #30202a;
    background: repeating-linear-gradient(0deg, #243544 0 7px, #1b2a39 7px 12px);
    transform: skewX(-24deg);
  }

  .roof--upper { top: 15%; left: 19%; width: 47%; }
  .roof--right { top: 34%; left: 57%; width: 30%; transform: skewX(20deg); }

  .beam {
    position: absolute;
    z-index: 11;
    height: 13px;
    background: #563528;
    border: 3px solid #2e2024;
  }

  .beam--upper { top: 45%; left: 20%; width: 65%; }
  .beam--middle { top: 68%; left: 8%; width: 79%; }
  .beam--lower { top: 86%; left: 38%; width: 55%; }

  .support {
    position: absolute;
    z-index: 10;
    width: 14px;
    background: #563528;
    border: 3px solid #2e2024;
  }

  .support--one { top: 43%; bottom: 0; left: 38%; }
  .support--two { top: 39%; bottom: 0; left: 79%; }
  .support--three { top: 67%; bottom: 0; left: 52%; }

  .bridge {
    position: absolute;
    top: 68%;
    left: 83%;
    width: 17%;
    height: 12px;
    background: repeating-linear-gradient(90deg, #71482f 0 13px, #38262a 13px 17px);
    border-block: 3px solid #2e2024;
  }

  .window {
    position: absolute;
    top: 17%;
    left: 10%;
    width: 24%;
    height: 38%;
    border: 4px solid #4d3540;
    background: linear-gradient(135deg, #9bd1db 0 48%, #d6b2ca 49% 100%);
    box-shadow: inset 50% 0 #4d3540;
  }

  .window--tall { left: 8%; width: 18%; height: 50%; }

  .table,
  .workbench,
  .bed,
  .shelf {
    position: absolute;
    display: block;
    background: #67412e;
    border: 3px solid #382426;
  }

  .table { right: 8%; bottom: 12%; width: 40%; height: 12%; box-shadow: 8px 14px 0 -3px #4e3028, 56px 14px 0 -3px #4e3028; }
  .table--wide { right: 6%; width: 46%; }
  .workbench { right: 7%; bottom: 13%; width: 48%; height: 18%; box-shadow: inset 0 5px #987044; }
  .bed { right: 7%; bottom: 12%; width: 55%; height: 18%; background: #72536c; box-shadow: inset 18px 0 #d8c59e; }
  .shelf { top: 17%; right: 7%; width: 28%; height: 38%; background: repeating-linear-gradient(0deg, #6f4932 0 9px, #32252b 9px 13px); }

  .asset { width: 32px; height: 32px; background-size: 544px 256px; }
  .asset--sign { top: 14%; left: 36%; background-position: -448px 0; }
  .asset--chest { right: 9%; bottom: 12%; background-position: -448px -128px; }
  .asset--bench { right: 8%; bottom: 12%; background-position: -480px -128px; }
  .asset--fire { right: 10%; bottom: 11%; background-position: -512px -128px; animation: hearth 1.5s steps(2, end) infinite; }
  .asset--ladder { left: 8%; bottom: 0; background-position: -224px -128px; }
  .asset--ladder-tall { height: 64px; background-repeat: repeat-y; }

  .asset--character {
    left: 47%;
    bottom: 10%;
    width: 32px;
    height: 32px;
    background-image: url('/assets/pixel-habitat/characters.png');
    background-size: 1472px 256px;
    background-position: 0 0;
  }

  .character--dock { z-index: 13; top: 63%; right: 6%; left: auto; }
  .chest--dock { z-index: 12; top: 64%; right: 11%; bottom: auto; }

  .lamp {
    position: absolute;
    z-index: 8;
    width: 10px;
    height: 10px;
    background: #fff08a;
    box-shadow: 0 0 14px 5px rgba(255, 210, 92, .5);
    animation: lamp-flicker 2.2s steps(2, end) infinite;
  }

  .lamp--one { top: 11%; left: 53%; }
  .lamp--two { top: 12%; right: 12%; }
  .lamp--three { top: 11%; left: 45%; }
  .lamp--four { top: 13%; right: 28%; }

  .firefly {
    position: absolute;
    z-index: 14;
    width: 5px;
    height: 5px;
    background: #ebff85;
    box-shadow: 0 0 8px #ebff85;
    animation: firefly 1.8s steps(2, end) infinite alternate;
  }

  .firefly--one { top: 35%; left: 10%; }
  .firefly--two { top: 48%; right: 9%; animation-delay: -.6s; }
  .firefly--three { top: 22%; left: 67%; animation-delay: -1.1s; }

  .pixel-habitat__credit {
    display: inline-block;
    margin-top: .35rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: .66rem;
    letter-spacing: .04em;
  }

  .pixel-habitat__credit:hover { color: var(--accent-home); }

  @keyframes cloud-drift { to { transform: translateX(20px); } }
  @keyframes hearth { 50% { filter: brightness(1.35); } }
  @keyframes lamp-flicker { 50% { opacity: .72; } }
  @keyframes firefly { to { opacity: .22; transform: translate(4px, -5px); } }

  @media (max-width: 820px) {
    .pixel-habitat { width: min(100%, 32rem); }
    .pixel-scene { height: 100%; width: 620px; aspect-ratio: auto; }
  }

  @media (max-width: 520px) {
    .pixel-habitat__frame { aspect-ratio: 16 / 10; }
    .pixel-scene { width: 600px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pixel-scene * { animation: none !important; }
  }

  :global(html[data-motion='reduced']) .pixel-scene * { animation: none !important; }
</style>
